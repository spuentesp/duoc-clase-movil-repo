+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun LocationScreen(onBackClick: () -> Unit = {}) {
+    val context = LocalContext.current
+    var hasLocationPermission by remember {
+        mutableStateOf(
+            ContextCompat.checkSelfPermission(
+                context,
+                Manifest.permission.ACCESS_FINE_LOCATION
+            ) == PackageManager.PERMISSION_GRANTED
+        )
+    }
+    var locationText by remember { mutableStateOf("") }
+
+    val launcher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.RequestMultiplePermissions()
+    ) { permissions ->
+        hasLocationPermission = permissions[Manifest.permission.ACCESS_FINE_LOCATION] == true ||
+                permissions[Manifest.permission.ACCESS_COARSE_LOCATION] == true
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("Ubicación / GPS") },
+                navigationIcon = {
+                    IconButton(onClick = onBackClick) {
+                        Icon(Icons.Default.ArrowBack, contentDescription = "Atrás")
+                    }
+                }
+            )
+        }
+    ) { paddingValues ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(paddingValues)
+                .padding(16.dp)
+                .verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(16.dp)
+        ) {
+            Text(
+                text = "Servicios de Ubicación",
+                style = MaterialTheme.typography.headlineSmall
+            )
+
+            Text(
+                text = "Obtén las coordenadas GPS del dispositivo.",
+                style = MaterialTheme.typography.bodyMedium
+            )
+
+            Divider()
+
+            if (!hasLocationPermission) {
+                Card(
+                    modifier = Modifier.fillMaxWidth(),
+                    colors = CardDefaults.cardColors(
+                        containerColor = MaterialTheme.colorScheme.errorContainer
+                    )
+                ) {
+                    Column(
+                        modifier = Modifier.padding(16.dp),
+                        horizontalAlignment = Alignment.CenterHorizontally
+                    ) {
+                        Text("Se requiere permiso de ubicación")
+                        Spacer(modifier = Modifier.height(8.dp))
+                        Button(onClick = {
+                            launcher.launch(
+                                arrayOf(
+                                    Manifest.permission.ACCESS_FINE_LOCATION,
+                                    Manifest.permission.ACCESS_COARSE_LOCATION
+                                )
+                            )
+                        }) {
+                            Text("Otorgar Permiso")
+                        }
+                    }
+                }
+            } else {
+                Button(
+                    onClick = {
+                        val fusedLocationClient = LocationServices.getFusedLocationProviderClient(context)
+                        try {
+                            fusedLocationClient.getCurrentLocation(
+                                Priority.PRIORITY_HIGH_ACCURACY,
+                                null
+                            ).addOnSuccessListener { location ->
+                                location?.let {
+                                    locationText = "Latitude: ${it.latitude}\nLongitude: ${it.longitude}"
+                                } ?: run {
+                                    locationText = "No se pudo obtener ubicación"
+                                }
+                            }
+                        } catch (e: SecurityException) {
+                            locationText = "Permiso denegado"
+                        }
+                    },
+                    modifier = Modifier.fillMaxWidth()
+                ) {
+                    Text("Obtener Ubicación Actual")
+                }
+
+                if (locationText.isNotEmpty()) {
+                    Card(
+                        modifier = Modifier.fillMaxWidth(),
+                        colors = CardDefaults.cardColors(
+                            containerColor = MaterialTheme.colorScheme.primaryContainer
+                        )
+                    ) {
+                        Column(modifier = Modifier.padding(16.dp)) {
+                            Text(
+                                text = "Ubicación Actual:",
+                                style = MaterialTheme.typography.titleSmall
+                            )
+                            Spacer(modifier = Modifier.height(8.dp))
+                            Text(text = locationText)
+                        }
+                    }
+                }
+            }
+
+            Divider()
+
+            Text(
+                text = "Ejemplo de Código:",
+                style = MaterialTheme.typography.titleMedium
+            )
+
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(
+                    containerColor = MaterialTheme.colorScheme.surfaceVariant
+                )
+            ) {
+                Text(
+                    text = """
+// 1. Obtener FusedLocationProviderClient
+val fusedLocationClient =
+    LocationServices.getFusedLocationProviderClient(context)
+
+// 2. Solicitar ubicación actual
+fusedLocationClient.getCurrentLocation(
+    Priority.PRIORITY_HIGH_ACCURACY,
+    null
+).addOnSuccessListener { location ->
+    location?.let {
+        val latitude = it.latitude
+        val longitude = it.longitude
+    }
+}
+
+// 3. Solicitar actualizaciones de ubicación
+val locationRequest = LocationRequest.Builder(
+    Priority.PRIORITY_HIGH_ACCURACY,
+    10000 // 10 segundos
+).build()
+
+val locationCallback = object : LocationCallback() {
+    override fun onLocationResult(result: LocationResult) {
+        for (location in result.locations) {
+            // Manejar actualización de ubicación
+        }
+    }
+}
+
+fusedLocationClient.requestLocationUpdates(
+    locationRequest,
+    locationCallback,
+    Looper.getMainLooper()
+)
+                    """.trimIndent(),
+                    modifier = Modifier.padding(16.dp),
+                    fontFamily = FontFamily.Monospace,
+                    style = MaterialTheme.typography.bodySmall
+                )
+            }
+
+            Card(
+                modifier = Modifier.fillMaxWidth(),
+                colors = CardDefaults.cardColors(
+                    containerColor = MaterialTheme.colorScheme.tertiaryContainer
+                )
+            ) {
+                Column(modifier = Modifier.padding(16.dp)) {
+                    Text(
+                        text = "Permisos Requeridos:",
+                        style = MaterialTheme.typography.titleSmall
+                    )
+                    Text(
+                        text = """
+<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
+<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
+                        """.trimIndent(),
+                        fontFamily = FontFamily.Monospace,
+                        style = MaterialTheme.typography.bodySmall
+                    )
+                    Spacer(modifier = Modifier.height(8.dp))
+                    Text(
+                        text = "Dependencia:",
+                        style = MaterialTheme.typography.titleSmall
+                    )
+                    Text(
+                        text = "implementation(\"com.google.android.gms:play-services-location:21.0.1\")",
+                        fontFamily = FontFamily.Monospace,
+                        style = MaterialTheme.typography.bodySmall
+                    )
+                }
+            }
+        }
+    }
+}
diff --git a/app/src/main/java/com/example/baseproject/ui/screens/features/NotificationsScreen.kt b/app/src/main/java/com/example/baseproject/ui/screens/features/NotificationsScreen.kt
